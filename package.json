{
  "name": "rituel",
  "version": "1.0.0",
  "private": true,
  "description": "Crypto card comparison & directory platform",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-cards.mts",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "db:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-cards.mts",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-cards.mts",
    "db:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-cards.mts",
    "db:backfill": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backfill-catalog.mts",
    "db:split-tiers": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/split-tier-cards.mts",
    "db:card-images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/set-card-images.mts",
    "blog:image": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/blog-image.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@neondatabase/serverless": "^1.2.0",
    "@portabletext/react": "^4.0.3",
    "@sanity/client": "^7.28.0",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.5.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.43.0",
    "next": "15.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.35.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "world-countries": "^5.1.0",
    "wrangler": "4.148.0"
  }
}
