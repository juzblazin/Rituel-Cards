# Copy to .env.local and fill in what you need. Nothing here is required:
# with no values set the directory renders from the committed card snapshot
# (src/lib/cards.generated.json) and the API routes fall back to logging.
# Never commit .env.local.

# --- Site ---
# Production origin for canonicals, Open Graph and the sitemap.
# Leave unset locally; production falls back to https://rituel.xyz.
NEXT_PUBLIC_SITE_URL=https://rituel.xyz
NEXT_PUBLIC_GA_ID=
ANALYTICS_WEBHOOK_URL=
SUBMISSIONS_WEBHOOK_URL=

# --- Neon Postgres ---
# Written by `neon deploy` / `neon env pull` from the branch linked in .neon.
# DATABASE_URL is pooled (host contains "-pooler"): application traffic.
# DATABASE_URL_UNPOOLED is direct: schema changes, dumps and replication.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Cloudflare R2 ---
# R2 > Manage in API Tokens > token with "Object Read & Write" scoped to the bucket.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public bucket or custom domain used by publicUrl().
R2_PUBLIC_BASE_URL=

# --- Resend ---
# Until a domain is verified, onboarding@resend.dev only delivers to your own
# Resend account address. Resend is email only; it has no SMS product.
RESEND_API_KEY=
# Bare address or "Rituel Cards <hello@rituel.xyz>"; a bare address gets the "Rituel Cards" name.
EMAIL_FROM=
EMAIL_NOTIFY_TO=hello@rituel.xyz

# Sanity — blog content. Defaults to the production project (uzbgef9r); not secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Official social profiles (comma-separated https URLs) for Organization sameAs schema.
NEXT_PUBLIC_SOCIAL_LINKS=
